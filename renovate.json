{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automergeSchedule": ["after 1am and before 6pm on every day"],
  "packageRules": [
    {
      "matchPackageNames": ["/.*/"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
