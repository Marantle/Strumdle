# Service worker and entry point: always revalidate (304 if unchanged, no full re-download)
/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Vite bundles have content-hashed filenames, safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable
